# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=add-your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=add-your-aws-secret-access-key-here
AWS_REGION=ap-south-1

# ── S3 ─────────────────────────────────────────────────────────────────────────
S3_BUCKET=your-rag-bucket-name

# ── SQS ────────────────────────────────────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/your-queue-name

# ── DynamoDB ───────────────────────────────────────────────────────────────────
DYNAMO_TABLE=rag-jobs
CHAT_CHECKPOINTS_TABLE=rag-chat-checkpoints
CHAT_WRITES_TABLE=rag-chat-writes

# ── LangGraph checkpointer: "dynamodb" | "sqlite" ─────────────────────────────
LANGGRAPH_CHECKPOINTER=dynamodb

# SQLite path (only used when LANGGRAPH_CHECKPOINTER=sqlite)
CHECKPOINTER_DB=chat_history.db

# ── LLM providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional — only needed if using Gemini LLM
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional — only needed if using Cohere reranker
COHERE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Frontend (copy to frontend/.env.local) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
